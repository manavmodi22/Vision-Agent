        "name": "ReadTextAndBarcodes",
        "inputs": {
          "source": {
            "type": "image_folder",
            "path": "media"
          }
        },
        "blocks": [
          {
            "id": "s",
            "type": "frame_sample",
            "params": {
              "fps": 2.0
            },
            "inputs": {
              "frames": "$inputs.source"
            }
          },
