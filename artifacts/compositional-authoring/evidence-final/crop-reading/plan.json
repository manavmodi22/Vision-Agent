  "content_hash": "d19d737d7b58e8c403b59ff96c063ec0e4d241bae2f6707e1ff44abc3dfe2101",
  "goal": "Build exactly one workflow. Read printed text only in the left half of each image: crop normalized [0, 0, 0.5, 1], then resize that crop to width 1200 and height 400 before OCR. Use apple-vision OCR. Compare the recognized text exactly to \"ABC-990\" and show the comparison result. Do not record events or send alerts. Use text_accuracy with target 0.9.",
  "assumptions": [
    "Use the project's imported media and saved region geometry.",
    "A sample preview does not establish accuracy.",
    "Evaluation requires reviewed labels on the same held-out data for every candidate."
  ],
  "candidates": [
    {
      "spec_version": "0.1",
      "name": "Read Left Half Text",
      "inputs": {
        "source": {
          "type": "image_folder",
          "path": "media"
        }
      },
      "blocks": [
        {
          "id": "s",
          "type": "frame_sample",
          "params": {
            "fps": 2.0
          },
          "inputs": {
            "frames": "$inputs.source"
          }
        },
        {
          "id": "c",
          "type": "crop",
          "params": {
            "box": [
              0.0,
              0.0,
              0.5,
              1.0
            ]
          },
          "inputs": {
            "image": "$s.frame"
          }
        },
        {
          "id": "r",
          "type": "resize",
          "params": {
            "width": 1200,
            "height": 400
          },
          "inputs": {
            "image": "$c.image"
          }
        },
        {
          "id": "o",
          "type": "ocr",
          "params": {
            "model": "apple-vision"
          },
          "inputs": {
            "image": "$r.image"
          }
        },
        {
          "id": "m",
          "type": "match",
          "params": {
            "expected": "ABC-990",
            "mode": "exact",
            "emit": "all"
          },
          "inputs": {
            "text": "$o.text"
          }
        }
      ],
      "eval": {
        "set": "reviewed-v1",
        "metric": "text_accuracy",
        "target": 0.9
      }
    }
  ],
  "required_capabilities": [
    "block.crop",
    "block.frame_sample",
    "block.match",
    "block.ocr",
    "block.resize",
    "model.apple-vision"
  ],
