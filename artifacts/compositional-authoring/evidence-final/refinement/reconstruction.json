{
  "reproduced": true,
  "dry_run": true,
  "effects_executed": false,
  "scope": "Pure captured refinement patch reconstruction; not replay of the unfinished build/review state machine",
  "candidates": [
    {
      "spec_version": "0.1",
      "name": "Read Left Half Text",
      "inputs": {
        "source": {
          "type": "image_folder",
          "path": "media"
        }
      },
      "blocks": [
        {
          "id": "s",
          "type": "frame_sample",
          "params": {
            "fps": 2.0
          },
          "in": {
            "frames": "$inputs.source"
          }
        },
        {
          "id": "c",
          "type": "crop",
          "params": {
            "box": [
              0.5,
              0.0,
              1.0,
              1.0
            ]
          },
          "in": {
            "image": "$s.frame"
          }
        },
        {
          "id": "r",
          "type": "resize",
          "params": {
            "width": 900,
            "height": 300
          },
          "in": {
            "image": "$c.image"
          }
        },
        {
          "id": "o",
          "type": "ocr",
          "params": {
            "model": "apple-vision"
          },
          "in": {
            "image": "$r.image"
          }
        },
        {
          "id": "m",
          "type": "match",
          "params": {
            "expected": "ABC-990",
            "mode": "exact",
            "emit": "all"
          },
          "in": {
            "text": "$o.text"
          }
        }
      ],
      "eval": {
        "set": "reviewed-v1",
        "metric": "text_accuracy",
        "target": 0.9
      }
    }
  ]
}
