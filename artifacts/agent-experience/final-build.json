  "spec": {
    "spec_version": "0.1",
    "name": "custom-candidate-1",
    "inputs": {
      "source": {
        "type": "image_folder",
        "path": "media"
      }
    },
    "blocks": [
      {
        "id": "sample",
        "type": "frame_sample",
        "params": {
          "fps": 2
        },
        "inputs": {
          "frames": "$inputs.source"
        }
      },
      {
        "id": "det",
        "type": "detect",
        "params": {
          "model": "owlv2-base-patch16",
          "classes": [
            "person"
          ],
          "min_conf": 0.2
        },
        "inputs": {
          "image": "$sample.frame"
        }
      },
      {
        "id": "count",
        "type": "count_per_zone",
        "params": {},
        "inputs": {
          "dets": "$det.dets"
        }
      },
      {
        "id": "full",
        "type": "rule",
        "params": {
          "when": "count >= 1",
          "hold_s": 0.0
        },
        "inputs": {
          "value": "$count.counts"
        }
      },
      {
        "id": "out",
        "type": "sink_event",
        "params": {},
        "inputs": {
          "event": "$full.event"
        }
      }
    ],
    "eval": {
      "set": "reviewed-v1",
      "metric": "count_mae",
      "target": 0.5
    }
  },
