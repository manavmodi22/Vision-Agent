    "content_hash": "bd0230257feea3777cad1ecafe1bfc378358235120ee77601b7608069e34f4ec",
    "goal": "Read printed labels and create a local event only when the text exactly equals \"ABC-990\".",
    "assumptions": [
      "Use the project's imported media and saved region geometry.",
      "A sample preview does not establish accuracy.",
      "Evaluation requires reviewed labels on the same held-out data for every candidate."
    ],
    "candidates": [
      {
        "spec_version": "0.1",
        "name": "custom-candidate-1",
        "inputs": {
          "source": {
            "type": "image_folder",
            "path": "media"
          }
        },
        "blocks": [
          {
            "id": "sample",
            "type": "frame_sample",
            "params": {
              "fps": 2
            },
            "inputs": {
              "frames": "$inputs.source"
            }
          },
          {
            "id": "read",
            "type": "ocr",
            "params": {},
            "inputs": {
              "image": "$sample.frame"
            }
          },
          {
            "id": "check",
            "type": "match",
            "params": {
              "expected": "ABC-990",
              "mode": "exact",
              "emit": "matched"
            },
            "inputs": {
              "text": "$read.text"
            }
          },
          {
            "id": "out",
            "type": "sink_event",
            "params": {},
            "inputs": {
              "event": "$check.event"
            }
          }
        ],
        "eval": {
          "set": "reviewed-v1",
          "metric": "text_accuracy",
          "target": 0.95
        }
      }
    ],
    "required_capabilities": [
      "block.frame_sample",
      "block.match",
      "block.ocr",
      "block.sink_event",
      "model.apple-vision"
    ],
